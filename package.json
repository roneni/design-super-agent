{
  "name": "design-super-agent",
  "version": "1.0.0",
  "description": "Autonomous design super agent — Claude Opus director with sub-agent executors",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test:judgment": "tsx tests/judgment-calibration.test.ts",
    "check-knowledge": "tsx -e \"import {loadKnowledge} from './src/knowledge/loader.js'; const m = await loadKnowledge('./src/knowledge'); console.log(m.length + ' modules loaded'); m.forEach(m => console.log('  ' + m.category + '/' + m.name))\"",
    "populate:references": "tsx scripts/populate-references.ts",
    "populate:screenshots": "tsx scripts/screenshot-sites.ts",
    "populate:all": "tsx scripts/populate-references.ts --all && tsx scripts/screenshot-sites.ts",
    "verify:references": "tsx scripts/populate-references.ts --verify"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.68",
    "@aws-sdk/client-s3": "^3.1004.0",
    "dotenv": "^17.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@types/node": "^20.19.35",
    "@types/sharp": "^0.31.1",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "zod": "^4.0.0"
  }
}
